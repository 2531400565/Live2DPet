<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 版本与文件元数据：右键 exe 属性/版本信息 + About 面板读取 -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Authors>时可凡</Authors>
    <Product>Live2D 桌宠 Live2DPet</Product>
    <Description>Live2D 桌面宠物：透明置顶实时渲染、互动养成、成就签到、节日彩蛋、一键截图与崩溃自启。</Description>
    <Copyright>Copyright © 2026 时可凡</Copyright>
    <RepositoryUrl>https://github.com/2531400565/Live2DPet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Live2DPet.Core\Live2DPet.Core.csproj" />
    <ProjectReference Include="..\Live2DPet.Platform\Live2DPet.Platform.csproj" />
    <ProjectReference Include="..\Live2DPet.Rendering\Live2DPet.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\config\**">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 原生 Cubism Core：P/Invoke 按名加载，随构建/发布输出（不打包进单文件，作为旁置 dll） -->
    <Content Include="..\..\thirdparty\Live2DCubismCore\Live2DCubismCore.dll">
      <Link>Live2DCubismCore.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
