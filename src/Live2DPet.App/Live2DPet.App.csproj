<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Live2DPet.Core\Live2DPet.Core.csproj" />
    <ProjectReference Include="..\Live2DPet.Platform\Live2DPet.Platform.csproj" />
    <ProjectReference Include="..\Live2DPet.Rendering\Live2DPet.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\config\**">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 原生 Cubism Core：P/Invoke 按名加载，随构建/发布输出（不打包进单文件，作为旁置 dll） -->
    <Content Include="..\..\thirdparty\Live2DCubismCore\Live2DCubismCore.dll">
      <Link>Live2DCubismCore.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
